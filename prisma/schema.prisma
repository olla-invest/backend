// Kiwoom Investment System Database Schema
// Generated from PostgreSQL DDL with Soft Delete support
// Using UUID for all IDs

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================
// Enums
// =============================================

enum MarketType {
  KOSPI
  KOSDAQ
  OTHER  @map("기타시장")

  @@map("market_type_enum")
}

enum MarketIndexType {
  KOSPI
  KOSDAQ

  @@map("market_index_type")
}

enum BatchJobType {
  STOCK_PRICE
  MARKET_INDEX
  RS_CALCULATION

  @@map("batch_job_type")
}

enum BatchJobStatus {
  RUNNING
  SUCCESS
  FAILED

  @@map("batch_job_status")
}

enum AuthProvider {
  LOCAL
  NAVER
  KAKAO

  @@map("auth_provider_enum")
}

enum PlanType {
  FREE
  BASIC
  PRO
  PREMIUM

  @@map("plan_type_enum")
}

enum SubscriptionStatus {
  ACTIVE     // 구독 활성
  INACTIVE   // 구독 비활성 (결제수단 없음 / 무료)
  CANCELLED  // 해지 예약됨 (기간 종료 후 FREE 전환)
  EXPIRED    // 만료됨
  PAST_DUE   // 정기결제 실패 (연체)

  @@map("subscription_status_enum")
}

enum PaymentStatus {
  PENDING    // 결제 대기
  SUCCESS    // 결제 성공
  FAILED     // 결제 실패
  CANCELLED  // 취소
  REFUNDED   // 환불

  @@map("payment_status_enum")
}

enum BillingCycle {
  MONTHLY
  YEARLY

  @@map("billing_cycle_enum")
}

// =============================================
// Models
// =============================================

// 1. 테마 마스터 테이블
model Theme {
  themeCode Int       @id @map("theme_code")
  themeName String    @map("theme_name") @db.VarChar(100)
  imageUrl  String?   @map("image_url") @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  companies       Company[]
  dailySnapshots  ThemeDailySnapshot[]
  watchlistUsers  UserWatchlistTheme[]

  @@unique([themeName, deletedAt], map: "uk_themes_name")
  @@index([themeName], map: "idx_themes_name")
  @@index([deletedAt], map: "idx_themes_deleted_at")
  @@map("themes")
}

// 2. 사용자 테이블
model User {
  userId           String       @id @default(uuid()) @map("user_id") @db.Uuid
  username         String       @db.VarChar(50)
  email            String       @db.VarChar(100)
  password         String?      @db.VarChar(255)
  provider         AuthProvider @default(LOCAL)
  socialId         String?      @map("social_id") @db.VarChar(100)
  name             String?      @db.VarChar(100)
  phone            String?      @db.VarChar(20)
  marketingConsent Boolean      @default(false) @map("marketing_consent")
  isTempPassword   Boolean      @default(false) @map("is_temp_password")
  planType         PlanType     @default(FREE) @map("plan_type")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")

  // Relations
  watchlist           UserWatchlist[]
  watchlistThemes     UserWatchlistTheme[]
  rsFilterPresets     RsFilterPreset[]
  searchFilterPresets SearchFilterPreset[]
  apiCallLogs         KiwoomApiCallLog[]
  subscription        UserSubscription?
  paymentCards        PaymentCard[]
  payments            Payment[]

  @@unique([username, deletedAt], map: "uk_users_username")
  @@unique([email, deletedAt], map: "uk_users_email")
  @@unique([provider, socialId, deletedAt], map: "uk_users_social")
  @@index([username], map: "idx_users_username")
  @@index([email], map: "idx_users_email")
  @@index([provider, socialId], map: "idx_users_provider_social")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

// 3. 기업 기본 정보 테이블
model Company {
  companyId   String     @id @default(uuid()) @map("company_id") @db.Uuid
  companyName String     @map("company_name") @db.VarChar(100)
  stockCode   String     @map("stock_code") @db.VarChar(20)
  marketType  MarketType @map("market_type")
  themeCode   Int?       @map("theme_code")
  corpCode      String?    @map("corp_code") @db.VarChar(8)
  listedShares  BigInt?    @map("listed_shares")
  businessInfo  Json?      @map("business_info") @db.JsonB
  tradingState  String?    @map("trading_state") @db.VarChar(20)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  // Relations
  theme        Theme?              @relation(fields: [themeCode], references: [themeCode])
  watchlist    UserWatchlist[]
  priceHistory StockPriceHistory[]

  @@unique([stockCode, deletedAt], map: "uk_companies_stock_code")
  @@index([stockCode], map: "idx_companies_stock_code")
  @@index([marketType], map: "idx_companies_market_type")
  @@index([companyName], map: "idx_companies_company_name")
  @@index([themeCode], map: "idx_companies_theme_code")
  @@index([deletedAt], map: "idx_companies_deleted_at")
  @@map("companies")
}

// 4. 사용자-관심종목 매핑 테이블
model UserWatchlist {
  userId    String    @map("user_id") @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  addedDate DateTime  @default(now()) @map("added_date")
  memo      String?   @db.Text
  deletedAt DateTime? @map("deleted_at")

  // Relations
  user    User           @relation(fields: [userId], references: [userId])
  company Company        @relation(fields: [companyId], references: [companyId])
  tags    WatchlistTag[]

  @@id([userId, companyId])
  @@index([userId, addedDate], map: "idx_watchlist_user_added_date")
  @@index([companyId], map: "idx_watchlist_company_id")
  @@index([deletedAt], map: "idx_watchlist_deleted_at")
  @@map("user_watchlist")
}

// 4-1. 사용자-관심테마 매핑 테이블
model UserWatchlistTheme {
  userId    String    @map("user_id") @db.Uuid
  themeCode Int       @map("theme_code")
  addedDate DateTime  @default(now()) @map("added_date")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  user  User  @relation(fields: [userId], references: [userId])
  theme Theme @relation(fields: [themeCode], references: [themeCode])

  @@id([userId, themeCode])
  @@index([userId, addedDate], map: "idx_watchlist_theme_user_added_date")
  @@index([themeCode], map: "idx_watchlist_theme_theme_code")
  @@index([deletedAt], map: "idx_watchlist_theme_deleted_at")
  @@map("user_watchlist_themes")
}

// 4. 태그 마스터 테이블
model Tag {
  tagId     String    @id @default(uuid()) @map("tag_id") @db.Uuid
  tagName   String    @map("tag_name") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  watchlistTags WatchlistTag[]

  @@unique([tagName, deletedAt], map: "uk_tags_tag_name")
  @@index([tagName], map: "idx_tags_tag_name")
  @@index([deletedAt], map: "idx_tags_deleted_at")
  @@map("tags")
}

// 5. 관심종목-태그 매핑 테이블
model WatchlistTag {
  userId    String    @map("user_id") @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  tagId     String    @map("tag_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  watchlist UserWatchlist @relation(fields: [userId, companyId], references: [userId, companyId])
  tag       Tag           @relation(fields: [tagId], references: [tagId])

  @@id([userId, companyId, tagId])
  @@index([tagId], map: "idx_watchlist_tags_tag_id")
  @@index([userId, companyId], map: "idx_watchlist_tags_user_company")
  @@index([deletedAt], map: "idx_watchlist_tags_deleted_at")
  @@map("watchlist_tags")
}

// 6. RS 필터 프리셋 테이블
model RsFilterPreset {
  presetId   String    @id @default(uuid()) @map("preset_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  presetName String    @map("preset_name") @db.VarChar(100)
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")

  // Relations
  user    User             @relation(fields: [userId], references: [userId])
  periods RsFilterPeriod[]

  @@unique([userId, presetName, deletedAt], map: "uk_rs_presets_user_name")
  @@index([userId], map: "idx_rs_presets_user_id")
  @@index([deletedAt], map: "idx_rs_presets_deleted_at")
  @@map("rs_filter_presets")
}

// 7. RS 필터 기간 설정 테이블
model RsFilterPeriod {
  periodId    String    @id @default(uuid()) @map("period_id") @db.Uuid
  presetId    String    @map("preset_id") @db.Uuid
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  weightRatio Decimal   @map("weight_ratio") @db.Decimal(5, 2)
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  preset RsFilterPreset @relation(fields: [presetId], references: [presetId])

  @@index([presetId], map: "idx_rs_periods_preset_id")
  @@index([deletedAt], map: "idx_rs_periods_deleted_at")
  @@map("rs_filter_periods")
}

// 8. 검색 필터 저장 테이블
model SearchFilterPreset {
  filterId     String    @id @default(uuid()) @map("filter_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  filterName   String    @map("filter_name") @db.VarChar(100)
  filterConfig Json      @map("filter_config") @db.JsonB
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  user User @relation(fields: [userId], references: [userId])

  @@unique([userId, filterName, deletedAt], map: "uk_search_presets_user_name")
  @@index([userId], map: "idx_search_presets_user_id")
  @@index([deletedAt], map: "idx_search_presets_deleted_at")
  @@map("search_filter_presets")
}

// 9. 종목 가격 히스토리 테이블
model StockPriceHistory {
  priceId      String   @id @default(uuid()) @map("price_id") @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  tradeDate    DateTime @map("trade_date") @db.Date
  openPrice    Decimal  @map("open_price") @db.Decimal(15, 2)
  highPrice    Decimal  @map("high_price") @db.Decimal(15, 2)
  lowPrice     Decimal  @map("low_price") @db.Decimal(15, 2)
  closePrice   Decimal  @map("close_price") @db.Decimal(15, 2)
  volume       BigInt
  tradingValue BigInt   @map("trading_value")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  company Company @relation(fields: [companyId], references: [companyId])

  @@unique([companyId, tradeDate], map: "uk_stock_price_company_date")
  @@index([companyId, tradeDate(sort: Desc)], map: "idx_stock_price_company_date")
  @@index([tradeDate], map: "idx_stock_price_trade_date")
  @@map("stock_price_history")
}

// 10. 시장 지수 히스토리 테이블
model MarketIndexHistory {
  indexId    String          @id @default(uuid()) @map("index_id") @db.Uuid
  marketType MarketIndexType @map("market_type")
  tradeDate  DateTime        @map("trade_date") @db.Date
  closeIndex Decimal         @map("close_index") @db.Decimal(10, 2)
  createdAt  DateTime        @default(now()) @map("created_at")

  @@unique([marketType, tradeDate], map: "uk_market_index_date")
  @@index([marketType, tradeDate(sort: Desc)], map: "idx_market_index_type_date")
  @@index([tradeDate], map: "idx_market_index_trade_date")
  @@map("market_index_history")
}

// 11. API 호출 이력 테이블 (Optional)
model KiwoomApiCallLog {
  logId           String   @id @default(uuid()) @map("log_id") @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  apiName         String   @map("api_name") @db.VarChar(50)
  stockCode       String?  @map("stock_code") @db.VarChar(20)
  requestData     Json?    @map("request_data") @db.JsonB
  responseStatus  String?  @map("response_status") @db.VarChar(20)
  responseMessage String?  @map("response_message") @db.Text
  callTimestamp   DateTime @default(now()) @map("call_timestamp")
  responseTimeMs  Int?     @map("response_time_ms")

  // Relations
  user User? @relation(fields: [userId], references: [userId])

  @@index([userId], map: "idx_api_log_user_id")
  @@index([apiName], map: "idx_api_log_api_name")
  @@index([callTimestamp], map: "idx_api_log_call_timestamp")
  @@index([stockCode], map: "idx_api_log_stock_code")
  @@map("kiwoom_api_call_log")
}

// 12. 데이터 수집 배치 이력 테이블 (Optional)
model BatchJobHistory {
  jobId          String         @id @default(uuid()) @map("job_id") @db.Uuid
  jobType        BatchJobType   @map("job_type")
  targetDate     DateTime       @map("target_date") @db.Date
  status         BatchJobStatus
  startTime      DateTime       @default(now()) @map("start_time")
  endTime        DateTime?      @map("end_time")
  processedCount Int            @default(0) @map("processed_count")
  errorMessage   String?        @map("error_message") @db.Text

  @@index([jobType], map: "idx_batch_job_type")
  @@index([targetDate], map: "idx_batch_target_date")
  @@index([status], map: "idx_batch_status")
  @@map("batch_job_history")
}

// =============================================
// Kiwoom API Real-time Chart Tables
// =============================================

// 13. 키움 OAuth 토큰 테이블
model KiwoomToken {
  tokenId   String   @id @default(uuid()) @map("token_id") @db.Uuid
  token     String   @db.Text
  tokenType String   @map("token_type") @db.VarChar(20)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([expiresAt], map: "idx_kiwoom_token_expires_at")
  @@map("kiwoom_tokens")
}

// 14. 주식 캔들 데이터 테이블 (일봉)
model StockCandle {
  candleId       String   @id @default(uuid()) @map("candle_id") @db.Uuid
  stockCode      String   @map("stock_code") @db.VarChar(20)
  candleType     String   @map("candle_type") @db.VarChar(10) // 'day'
  candleTime     DateTime @map("candle_time") @db.Date
  openPrice      Decimal  @map("open_price") @db.Decimal(15, 2)
  highPrice      Decimal  @map("high_price") @db.Decimal(15, 2)
  lowPrice       Decimal  @map("low_price") @db.Decimal(15, 2)
  closePrice     Decimal  @map("close_price") @db.Decimal(15, 2)
  volume              BigInt
  tradingValue        BigInt?  @map("trading_value")
  prevDayCompare      Decimal? @map("prev_day_compare") @db.Decimal(15, 2)
  adjOpenPrice        Decimal? @map("adj_open_price") @db.Decimal(15, 2)   // 수정주가 시가
  adjHighPrice        Decimal? @map("adj_high_price") @db.Decimal(15, 2)   // 수정주가 고가
  adjLowPrice         Decimal? @map("adj_low_price") @db.Decimal(15, 2)    // 수정주가 저가
  adjClosePrice       Decimal? @map("adj_close_price") @db.Decimal(15, 2)  // 수정주가 종가
  createdAt           DateTime @default(now()) @map("created_at")

  @@unique([stockCode, candleType, candleTime], map: "uk_stock_candle")
  @@index([stockCode, candleType, candleTime(sort: Desc)], map: "idx_stock_candle_query")
  @@index([candleTime], map: "idx_stock_candle_time")
  @@map("stock_candles")
}

// 15. 실시간 체결 데이터 테이블 (틱 데이터)
model StockTick {
  tickId          String   @id @default(uuid()) @map("tick_id") @db.Uuid
  stockCode       String   @map("stock_code") @db.VarChar(20)
  tickTime        DateTime @map("tick_time")
  price           Decimal  @db.Decimal(15, 2)
  volume          BigInt
  prevDayCompare  Decimal? @map("prev_day_compare") @db.Decimal(15, 2)
  changeRate      Decimal? @map("change_rate") @db.Decimal(10, 4)
  askPrice        Decimal? @map("ask_price") @db.Decimal(15, 2)
  bidPrice        Decimal? @map("bid_price") @db.Decimal(15, 2)
  accVolume       BigInt?  @map("acc_volume")
  accTradingValue BigInt?  @map("acc_trading_value")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([stockCode, tickTime(sort: Desc)], map: "idx_stock_tick_query")
  @@index([tickTime], map: "idx_stock_tick_time")
  @@map("stock_ticks")
}

// 16. 실시간 호가 데이터 테이블
model StockQuote {
  quoteId        String   @id @default(uuid()) @map("quote_id") @db.Uuid
  stockCode      String   @map("stock_code") @db.VarChar(20)
  quoteTime      DateTime @map("quote_time")
  askPrice1      Decimal? @map("ask_price_1") @db.Decimal(15, 2)
  askVolume1     BigInt?  @map("ask_volume_1")
  bidPrice1      Decimal? @map("bid_price_1") @db.Decimal(15, 2)
  bidVolume1     BigInt?  @map("bid_volume_1")
  askPrice2      Decimal? @map("ask_price_2") @db.Decimal(15, 2)
  askVolume2     BigInt?  @map("ask_volume_2")
  bidPrice2      Decimal? @map("bid_price_2") @db.Decimal(15, 2)
  bidVolume2     BigInt?  @map("bid_volume_2")
  askPrice3      Decimal? @map("ask_price_3") @db.Decimal(15, 2)
  askVolume3     BigInt?  @map("ask_volume_3")
  bidPrice3      Decimal? @map("bid_price_3") @db.Decimal(15, 2)
  bidVolume3     BigInt?  @map("bid_volume_3")
  askPrice4      Decimal? @map("ask_price_4") @db.Decimal(15, 2)
  askVolume4     BigInt?  @map("ask_volume_4")
  bidPrice4      Decimal? @map("bid_price_4") @db.Decimal(15, 2)
  bidVolume4     BigInt?  @map("bid_volume_4")
  askPrice5      Decimal? @map("ask_price_5") @db.Decimal(15, 2)
  askVolume5     BigInt?  @map("ask_volume_5")
  bidPrice5      Decimal? @map("bid_price_5") @db.Decimal(15, 2)
  bidVolume5     BigInt?  @map("bid_volume_5")
  totalAskVolume BigInt?  @map("total_ask_volume")
  totalBidVolume BigInt?  @map("total_bid_volume")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([stockCode, quoteTime(sort: Desc)], map: "idx_stock_quote_query")
  @@index([quoteTime], map: "idx_stock_quote_time")
  @@map("stock_quotes")
}

// 17. 테마 일별 스냅샷 테이블 (이슈테마 순위변동/인사이트 계산용)
model ThemeDailySnapshot {
  snapshotId      String   @id @default(uuid()) @map("snapshot_id") @db.Uuid
  themeCode       Int      @map("theme_code")
  snapshotDate    DateTime @map("snapshot_date") @db.Date
  rank            Int      @map("rank")                                        // 당일 순위 (상승비율 기준)
  risingCount     Int      @map("rising_count")                                // 상승 종목 수 (등락률 > 0%)
  totalCount      Int      @map("total_count")                                 // 전체 종목 수 (실시간차트 기준)
  risingRatio     Decimal  @map("rising_ratio") @db.Decimal(5, 2)             // 상승 비율 (%)
  avgChangeRate   Decimal  @map("avg_change_rate") @db.Decimal(8, 4)          // 평균 등락률 (%)
  highVolumeCount Int      @default(0) @map("high_volume_count")              // 거래대금 급증 종목 수
  upCount         Int      @default(0) @map("up_count")                       // 상승 종목 수 (등락률 >= +1%)
  flatCount       Int      @default(0) @map("flat_count")                     // 보합 종목 수 (-1% ~ +1%)
  downCount       Int      @default(0) @map("down_count")                     // 하락 종목 수 (등락률 <= -1%)
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  theme Theme @relation(fields: [themeCode], references: [themeCode])

  @@unique([themeCode, snapshotDate], map: "uk_theme_snapshot_code_date")
  @@index([snapshotDate, rank], map: "idx_theme_snapshot_date_rank")
  @@index([themeCode, snapshotDate(sort: Desc)], map: "idx_theme_snapshot_code_date")
  @@map("theme_daily_snapshots")
}

// 18. 종목 장중 누적 거래대금 스냅샷 테이블 (전일 동시간 비교용)
model StockTradingValueSnapshot {
  snapshotId      String   @id @default(uuid()) @map("snapshot_id") @db.Uuid
  stockCode       String   @map("stock_code") @db.VarChar(20)
  snapshotDate    DateTime @map("snapshot_date") @db.Date
  snapshotTime    String   @map("snapshot_time") @db.VarChar(4)               // HHmm (10분 단위, ex: "1030")
  accTradingValue BigInt   @map("acc_trading_value")                           // 해당 시점 누적 거래대금
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([stockCode, snapshotDate, snapshotTime], map: "uk_trading_snapshot")
  @@index([snapshotDate, snapshotTime], map: "idx_trading_snapshot_date_time")
  @@index([stockCode, snapshotDate(sort: Desc)], map: "idx_trading_snapshot_code_date")
  @@map("stock_trading_value_snapshots")
}

// 19. 일별 종목 지표 테이블 (계산된 값 저장)
model StockDailyMetrics {
  metricId              String   @id @default(uuid()) @map("metric_id") @db.Uuid
  stockCode             String   @map("stock_code") @db.VarChar(20)
  tradeDate             DateTime @map("trade_date") @db.Date
  closePrice            Decimal  @map("close_price") @db.Decimal(15, 2)
  relativeStrengthScore Decimal  @map("relative_strength_score") @db.Decimal(5, 2) // RS 점수 (디폴트 63일)
  rank                  Int      @map("rank")
  marketType            String   @map("market_type") @db.VarChar(10) // '0' (KOSPI), '10' (KOSDAQ), '8' (ETF)
  isNewHigh             Boolean  @default(false) @map("is_new_high")
  highPrice52w          Decimal? @map("high_price_52w") @db.Decimal(15, 2)
  lowPrice52w           Decimal? @map("low_price_52w") @db.Decimal(15, 2)
  priceChange1d         Decimal? @map("price_change_1d") @db.Decimal(15, 2)
  priceChangeRate1d     Decimal? @map("price_change_rate_1d") @db.Decimal(10, 4)
  volume1d              BigInt?  @map("volume_1d")
  tradingValue          BigInt?  @map("trading_value")
  ma50                  Decimal? @map("ma_50") @db.Decimal(15, 2)
  passedStaticFilters         Boolean  @default(false) @map("passed_static_filters")
  isVolatilityContraction     Boolean  @default(false) @map("is_volatility_contraction")
  isPriceCompression          Boolean  @default(false) @map("is_price_compression")
  isTrendTemplate             Boolean  @default(false) @map("is_trend_template")
  strengthContinuationDays    Int?     @map("strength_continuation_days")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([stockCode, tradeDate], map: "uk_stock_metrics_code_date")
  @@index([tradeDate, marketType, rank], map: "idx_stock_metrics_date_market_rank")
  @@index([stockCode, tradeDate(sort: Desc)], map: "idx_stock_metrics_code_date")
  @@index([marketType, tradeDate], map: "idx_stock_metrics_market_date")
  @@map("stock_daily_metrics")
}

// 19-1. 크론 실행 이력 (catch-up / 모니터링용)
model CronRunLog {
  runId       String   @id @default(uuid()) @map("run_id") @db.Uuid
  jobName     String   @map("job_name") @db.VarChar(80)
  tradeDate   DateTime @map("trade_date") @db.Date
  status      String   @map("status") @db.VarChar(16) // RUNNING / SUCCESS / FAILED
  startedAt   DateTime @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  durationMs  Int?     @map("duration_ms")
  errorMsg    String?  @map("error_msg") @db.Text
  metadata    Json?    @map("metadata")

  @@unique([jobName, tradeDate], map: "uk_cron_run_log_job_date")
  @@index([jobName, status, tradeDate(sort: Desc)], map: "idx_cron_run_log_status")
  @@map("cron_run_log")
}

// =============================================
// MyPage - 구독 / 결제 관련 테이블
// =============================================

// 20. 사용자 구독 정보 테이블 (1 User : 1 Subscription)
model UserSubscription {
  subscriptionId     String             @id @default(uuid()) @map("subscription_id") @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  planType           PlanType           @map("plan_type")
  status             SubscriptionStatus @default(INACTIVE) @map("status")
  billingCycle       BillingCycle       @map("billing_cycle")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  nextBillingDate    DateTime?          @map("next_billing_date")
  cancelledAt        DateTime?          @map("cancelled_at")         // 해지 요청 일시
  cancelEffectiveAt  DateTime?          @map("cancel_effective_at")  // 해지 실제 적용 일시 (= currentPeriodEnd)
  pendingPlanType    PlanType?          @map("pending_plan_type")    // 다운그레이드 예약 플랜
  pendingBillingCycle BillingCycle?     @map("pending_billing_cycle")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")

  // Relations
  user     User      @relation(fields: [userId], references: [userId])
  payments Payment[]

  @@index([userId], map: "idx_subscription_user_id")
  @@index([status], map: "idx_subscription_status")
  @@index([nextBillingDate], map: "idx_subscription_next_billing")
  @@map("user_subscriptions")
}

// 21. 사용자 결제 카드 정보 테이블 (Toss Payments 빌링키)
model PaymentCard {
  cardId     String    @id @default(uuid()) @map("card_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  billingKey String    @map("billing_key") @db.VarChar(200)  // Toss 빌링키
  cardNumber String    @map("card_number") @db.VarChar(25)   // 마스킹된 카드번호 (예: ****-****-****-1234)
  cardType   String?   @map("card_type") @db.VarChar(50)     // VISA, MASTER, 현대 등
  issuerCode String?   @map("issuer_code") @db.VarChar(10)   // 발급사 코드
  ownerType  String?   @map("owner_type") @db.VarChar(10)    // 개인 / 법인
  isDefault  Boolean   @default(true) @map("is_default")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  // Relations
  user User @relation(fields: [userId], references: [userId])

  @@index([userId], map: "idx_payment_card_user_id")
  @@index([deletedAt], map: "idx_payment_card_deleted_at")
  @@map("payment_cards")
}

// 22. 결제 내역 테이블
model Payment {
  paymentId      String        @id @default(uuid()) @map("payment_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  orderId        String        @unique @map("order_id") @db.VarChar(100)   // 우리 시스템 주문 ID (Toss에 전달)
  tossPaymentKey String?       @map("toss_payment_key") @db.VarChar(200)   // Toss 결제 키 (성공 시)
  amount         Int           @map("amount")                               // 결제 금액 (원)
  planType       PlanType      @map("plan_type")
  billingCycle   BillingCycle  @map("billing_cycle")
  status         PaymentStatus @default(PENDING) @map("status")
  paymentMethod  String?       @map("payment_method") @db.VarChar(50)      // CARD 등
  cardInfo       Json?         @map("card_info") @db.JsonB                  // Toss 응답 카드 정보
  failureCode    String?       @map("failure_code") @db.VarChar(50)
  failureMessage String?       @map("failure_message") @db.Text
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  // Relations
  user         User              @relation(fields: [userId], references: [userId])
  subscription UserSubscription? @relation(fields: [subscriptionId], references: [subscriptionId])

  @@index([userId], map: "idx_payment_user_id")
  @@index([subscriptionId], map: "idx_payment_subscription_id")
  @@index([status], map: "idx_payment_status")
  @@index([paidAt(sort: Desc)], map: "idx_payment_paid_at")
  @@map("payments")
}
